generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  extensions        = [pg_trgm]
}

enum RoleName {
  super_admin
  hr_admin
  recruiter
  manager
  employee
  finance
  it_admin
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum SubscriptionPlan {
  STARTER
  GROWTH
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  OVERDUE
  CANCELLED
}

enum IpRestrictionType {
  ALLOW
  BLOCK
}

enum EmploymentCategory {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_NOTICE
  TERMINATED
}

enum WorkMode {
  OFFICE
  WFH
  HYBRID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  HOLIDAY
  WEEK_OFF
}

enum AttendanceMode {
  MANUAL
  QR
  GPS
  WFH
  BIOMETRIC
}

enum RegularizationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CompOffStatus {
  PENDING
  APPROVED
  REJECTED
  USED
}

enum PayrollRunStatus {
  DRAFT
  REVIEW
  APPROVED
  FINALIZED
  CANCELLED
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
  REIMBURSEMENT
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW_SCHEDULED
  OFFER
  HIRED
  REJECTED
}

enum CandidateDecision {
  PENDING
  ACCEPTED
  DECLINED
  REJECTED
}

enum OnboardingDocStatus {
  PENDING
  UPLOADED
  VERIFIED
  REJECTED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum DocumentRequestStatus {
  PENDING
  FULFILLED
  REJECTED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_REPAIR
  RETIRED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
}

enum AssetRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExpenseStatus {
  SUBMITTED
  MANAGER_APPROVED
  FINANCE_APPROVED
  REJECTED
  PAID
}

enum ReviewCycleType {
  ANNUAL
  MID_YEAR
  QUARTERLY
}

enum ReviewStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  LOCKED
}

enum PipStatus {
  ACTIVE
  COMPLETED
  FAILED
  CANCELLED
}

enum CourseProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum QuizAttemptStatus {
  PASSED
  FAILED
}

model Organization {
  id                  String             @id @default(uuid()) @db.Uuid
  name                String
  slug                String             @unique
  subdomain           String             @unique
  status              OrganizationStatus @default(ACTIVE)
  plan                SubscriptionPlan   @default(STARTER)
  subscriptionStatus  SubscriptionStatus @default(TRIAL)
  employeeLimit       Int                @default(25)
  storageLimitMb      Int                @default(10240)
  storageUsedMb       Int                @default(0)
  billingEmail        String
  trialEndsAt         DateTime?
  isDeleted           Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  users               User[]
  roles               Role[]
  permissions         Permission[]
  departments         Department[]
  designations        Designation[]
  employmentTypes     EmploymentType[]
  workLocations       WorkLocation[]
  employees           Employee[]
  userSessions        UserSession[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  otpCodes            OtpCode[]
  ipRestrictions      IpRestriction[]
  rolePermissions     RolePermission[]
  employeeTimelines   EmployeeTimeline[]
  employeeDocuments   EmployeeDocument[]
  leavePolicies       LeavePolicy[]
  leaveTypes          LeaveType[]
  leaveBalances       LeaveBalance[]
  leaveApplications   LeaveApplication[]
  leaveApprovals      LeaveApproval[]
  holidays            Holiday[]
  compOffRequests     CompOffRequest[]
  shifts              Shift[]
  shiftAssignments    ShiftAssignment[]
  attendanceLogs      AttendanceLog[]
  breakLogs           BreakLog[]
  geoFences           GeoFence[]
  regularizationRequests RegularizationRequest[]
  salaryStructures    SalaryStructure[]
  salaryComponents    SalaryComponent[]
  employeeSalaries    EmployeeSalary[]
  payrollRuns         PayrollRun[]
  payrollEntries      PayrollEntry[]
  payslips            Payslip[]
  taxDeclarations     TaxDeclaration[]
  reimbursements      Reimbursement[]
  salaryRevisions     SalaryRevision[]
  bonuses             Bonus[]
  bankDetails         BankDetail[]
  recruitmentSources  RecruitmentSource[]
  jobPostings         JobPosting[]
  candidates          Candidate[]
  applications        Application[]
  interviews          Interview[]
  interviewFeedbacks  InterviewFeedback[]
  offerLetters        OfferLetter[]
  onboardingChecklists OnboardingChecklist[]
  onboardingAssignments OnboardingAssignment[]
  onboardingTasks     OnboardingTask[]
  onboardingDocuments OnboardingDocument[]
  esignatures         Esignature[]
  documentTemplates   DocumentTemplate[]
  documentRequests    DocumentRequest[]
  documentDownloads   DocumentDownload[]
  goals               Goal[]
  okrs                Okr[]
  reviewCycles        ReviewCycle[]
  kpiTemplates        KpiTemplate[]
  performanceReviews  PerformanceReview[]
  selfAssessments     SelfAssessment[]
  managerAssessments  ManagerAssessment[]
  peerFeedbacks       PeerFeedback[]
  pips                Pip[]
  notifications       Notification[]
  notificationPreferences NotificationPreference[]
  assets              Asset[]
  assetTypes          AssetType[]
  assetAllocations    AssetAllocation[]
  assetRequests       AssetRequest[]
  assetReturns        AssetReturn[]
  expensePolicies     ExpensePolicy[]
  expenseClaims       ExpenseClaim[]
  tickets             Ticket[]
  ticketComments      TicketComment[]
  productivityConsents ProductivityConsent[]
  productivityLogs    ProductivityLog[]
  productivityActivities ProductivityActivity[]
  productivityScreenshots ProductivityScreenshot[]
  courses             Course[]
  courseModules       CourseModule[]
  courseAssignments   CourseAssignment[]
  courseProgress      CourseProgress[]
  quizzes             Quiz[]
  quizQuestions       QuizQuestion[]
  quizAttempts        QuizAttempt[]
  learningCertificates LearningCertificate[]
  billingSubscription BillingSubscription?
  orgUsageStats       OrgUsageStat[]
  impersonationLogs   ImpersonationLog[]
  notificationTemplates NotificationTemplate[]

  @@map("organizations")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  name        RoleName
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users        User[]
  rolePermissions RolePermission[]

  @@unique([orgId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  key         String
  description String?
  createdAt   DateTime @default(now())

  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([orgId, key])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([orgId, roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  orgId            String    @db.Uuid
  roleId           String    @db.Uuid
  email            String
  passwordHash     String?
  firstName        String
  lastName         String
  avatarKey        String?
  isActive         Boolean   @default(true)
  isInviteAccepted Boolean   @default(false)
  mfaEnabled       Boolean   @default(false)
  lastLoginAt      DateTime?
  consentAt        DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization      Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role              Role               @relation(fields: [roleId], references: [id])
  sessions          UserSession[]
  auditLogs         AuditLog[]
  passwordResetTokens PasswordResetToken[]
  otpCodes          OtpCode[]
  notifications     Notification[]
  notificationPreference NotificationPreference?
  employee          Employee?
  ipRestrictionsCreated IpRestriction[] @relation("IpRestrictionCreatedBy")
  employeeTimelines EmployeeTimeline[] @relation("EmployeeTimelineCreatedBy")
  documentUploaded  EmployeeDocument[] @relation("DocumentUploadedBy")
  documentVerified  EmployeeDocument[] @relation("DocumentVerifiedBy")
  payrollInitiated  PayrollRun[]       @relation("PayrollInitiatedBy")
  payrollApproved   PayrollRun[]       @relation("PayrollApprovedBy")
  salariesCreated   EmployeeSalary[]   @relation("EmployeeSalaryCreatedBy")
  salaryRevisionsApproved SalaryRevision[] @relation("SalaryRevisionApprovedBy")
  bonusesCreated    Bonus[]            @relation("BonusCreatedBy")
  offersGenerated   OfferLetter[]      @relation("OfferGeneratedBy")
  interviewsConducted Interview[]      @relation("InterviewConductedBy")
  interviewFeedbacks InterviewFeedback[]
  regularizationApproved RegularizationRequest[] @relation("RegularizationApprover")
  leaveApprovals LeaveApproval[] @relation("LeaveApprover")
  compOffApprovals CompOffRequest[] @relation("CompOffApprover")
  goalsManaged    Goal[]             @relation("GoalManager")
  onboardingAssigned OnboardingAssignment[] @relation("OnboardingAssignedBy")
  onboardingManaged  OnboardingAssignment[] @relation("OnboardingManager")
  onboardingBuddyFor OnboardingAssignment[] @relation("OnboardingBuddy")
  onboardingDocsVerified OnboardingDocument[] @relation("OnboardingDocumentVerifiedBy")
  performanceManaged PerformanceReview[] @relation("PerformanceManager")
  notificationsSent Notification[] @relation("NotificationSentBy")
  assetAllocatedBy  AssetAllocation[]  @relation("AssetAllocatedBy")
  assetRequestsApproved AssetRequest[] @relation("AssetRequestApprovedBy")
  assetReturnsProcessed AssetReturn[]  @relation("AssetReturnProcessedBy")
  ticketsAssigned   Ticket[]           @relation("TicketAssignee")
  ticketsCreated    Ticket[]           @relation("TicketCreatedBy")
  ticketComments    TicketComment[]
  expenseManagerApproved ExpenseClaim[] @relation("ExpenseManagerApprovedBy")
  expenseFinanceApproved ExpenseClaim[] @relation("ExpenseFinanceApprovedBy")
  courseCreated     Course[]

  @@unique([orgId, email])
  @@map("users")
}

model UserSession {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @db.Uuid
  userId          String    @db.Uuid
  refreshTokenHash String
  ipAddress       String?
  userAgent       String?
  deviceOs        String?
  deviceBrowser   String?
  location        String?
  lastActiveAt    DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, userId])
  @@map("user_sessions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  userId     String?  @db.Uuid
  action     String
  module     String
  entityName String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, module, entityName])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  userId    String   @db.Uuid
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, userId])
  @@map("password_reset_tokens")
}

model OtpCode {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  userId     String   @db.Uuid
  purpose    String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, userId, purpose])
  @@map("otp_codes")
}

model IpRestriction {
  id          String            @id @default(uuid()) @db.Uuid
  orgId       String            @db.Uuid
  type        IpRestrictionType
  ipAddress   String
  cidr        String?
  reason      String?
  isActive    Boolean           @default(true)
  createdBy   String?           @db.Uuid
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdByUser User?       @relation("IpRestrictionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([orgId, ipAddress])
  @@map("ip_restrictions")
}

model Department {
  id                 String   @id @default(uuid()) @db.Uuid
  orgId              String   @db.Uuid
  parentDepartmentId String?  @db.Uuid
  headId             String?  @db.Uuid
  name               String
  code               String?
  description        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parentDepartment Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments Department[] @relation("DepartmentHierarchy")
  head            Employee?     @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  employees       Employee[]
  shiftAssignments ShiftAssignment[]
  designations    Designation[]
  jobPostings     JobPosting[]
  courseAssignments CourseAssignment[]

  @@unique([orgId, name])
  @@map("departments")
}

model Designation {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @db.Uuid
  departmentId String?  @db.Uuid
  name         String
  level        String?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees    Employee[]
  kpiTemplates KpiTemplate[]

  @@unique([orgId, name])
  @@map("designations")
}

model EmploymentType {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @db.Uuid
  name          String
  description   String?
  defaultLeaves Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([orgId, name])
  @@map("employment_types")
}

model WorkLocation {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  name        String
  mode        WorkMode
  latitude    Float?
  longitude   Float?
  radiusMeters Int?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employees    Employee[]
  geoFences    GeoFence[]

  @@unique([orgId, name])
  @@map("work_locations")
}

model Employee {
  id               String             @id @default(uuid()) @db.Uuid
  orgId            String             @db.Uuid
  userId           String?            @unique @db.Uuid
  employeeCode     String
  firstName        String
  lastName         String
  email            String
  phone            String?
  gender           String?
  dateOfBirth      DateTime?
  joinDate         DateTime
  exitDate         DateTime?
  status           EmploymentStatus   @default(ACTIVE)
  employmentCategory EmploymentCategory
  workMode         WorkMode           @default(OFFICE)
  departmentId     String?            @db.Uuid
  designationId    String?            @db.Uuid
  employmentTypeId String?            @db.Uuid
  workLocationId   String?            @db.Uuid
  managerId        String?            @db.Uuid
  ctcPaise         Int?
  panEncrypted     String?
  aadhaarEncrypted String?
  personalData     Json?
  emergencyContact Json?
  isDeleted        Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization       Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user               User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  department         Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation        Designation?      @relation(fields: [designationId], references: [id], onDelete: SetNull)
  employmentType     EmploymentType?   @relation(fields: [employmentTypeId], references: [id], onDelete: SetNull)
  workLocation       WorkLocation?     @relation(fields: [workLocationId], references: [id], onDelete: SetNull)
  manager            Employee?         @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports      Employee[]        @relation("EmployeeManager")
  departmentsHeaded  Department[]      @relation("DepartmentHead")
  timeline           EmployeeTimeline[]
  documents          EmployeeDocument[]
  attendanceLogs     AttendanceLog[]
  regularizationRequests RegularizationRequest[]
  shiftAssignments   ShiftAssignment[]
  leaveBalances      LeaveBalance[]
  leaveApplications  LeaveApplication[]
  compOffRequests    CompOffRequest[]
  employeeSalaries   EmployeeSalary[]
  payrollEntries     PayrollEntry[]
  payslips           Payslip[]
  taxDeclarations    TaxDeclaration[]
  reimbursements     Reimbursement[]
  salaryRevisions    SalaryRevision[]
  bonuses            Bonus[]
  bankDetails        BankDetail[]
  documentRequests   DocumentRequest[]
  esignatures        Esignature[]
  onboardingAssignments OnboardingAssignment[]
  onboardingDocuments OnboardingDocument[]
  goals              Goal[]
  okrs               Okr[]
  performanceReviews PerformanceReview[]
  selfAssessments    SelfAssessment[]
  managerAssessments ManagerAssessment[]
  peerFeedbackGiven  PeerFeedback[] @relation("PeerFeedbackFrom")
  peerFeedbackReceived PeerFeedback[] @relation("PeerFeedbackTo")
  pips               Pip[]
  notifications      Notification[]
  assetAllocations   AssetAllocation[]
  assetRequests      AssetRequest[]
  expenseClaims      ExpenseClaim[]
  tickets            Ticket[]
  productivityConsents ProductivityConsent[]
  productivityLogs   ProductivityLog[]
  productivityScreenshots ProductivityScreenshot[]
  productivityActivities ProductivityActivity[]
  courseAssignments  CourseAssignment[]
  courseProgress     CourseProgress[]
  quizAttempts       QuizAttempt[]
  certificates       LearningCertificate[]

  @@unique([orgId, employeeCode])
  @@index([orgId, firstName, lastName])
  @@map("employees")
}

model EmployeeTimeline {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  employeeId  String   @db.Uuid
  eventType   String
  title       String
  description String?
  metadata    Json?
  occurredAt  DateTime
  createdBy   String?  @db.Uuid
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdByUser User?       @relation("EmployeeTimelineCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([orgId, employeeId, occurredAt])
  @@map("employee_timeline")
}

model EmployeeDocument {
  id          String             @id @default(uuid()) @db.Uuid
  orgId       String             @db.Uuid
  employeeId  String             @db.Uuid
  documentType String
  fileName    String
  fileKey     String
  fileUrl     String?
  mimeType    String?
  fileSize    Int?
  status      OnboardingDocStatus @default(PENDING)
  expiresAt   DateTime?
  uploadedBy  String?            @db.Uuid
  verifiedBy  String?            @db.Uuid
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedByUser User?      @relation("DocumentUploadedBy", fields: [uploadedBy], references: [id], onDelete: SetNull)
  verifiedByUser User?      @relation("DocumentVerifiedBy", fields: [verifiedBy], references: [id], onDelete: SetNull)
  documentDownloads DocumentDownload[]
  documentRequests  DocumentRequest[]

  @@index([orgId, employeeId, documentType])
  @@map("employee_documents")
}

model Shift {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @db.Uuid
  name             String
  code             String?
  startTime        String
  endTime          String
  gracePeriodMins  Int      @default(10)
  overtimeAfterMins Int     @default(0)
  isNightShift     Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignments    ShiftAssignment[]
  attendanceLogs AttendanceLog[]

  @@unique([orgId, name])
  @@map("shifts")
}

model ShiftAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @db.Uuid
  shiftId      String   @db.Uuid
  employeeId   String?  @db.Uuid
  departmentId String?  @db.Uuid
  effectiveFrom DateTime
  effectiveTo  DateTime?
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  shift        Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([orgId, shiftId, employeeId])
  @@map("shift_assignments")
}

model AttendanceLog {
  id              String           @id @default(uuid()) @db.Uuid
  orgId           String           @db.Uuid
  employeeId      String           @db.Uuid
  shiftId         String?          @db.Uuid
  geoFenceId      String?          @db.Uuid
  date            DateTime
  checkInAt       DateTime?
  checkOutAt      DateTime?
  status          AttendanceStatus @default(PRESENT)
  mode            AttendanceMode   @default(MANUAL)
  lateByMinutes   Int              @default(0)
  overtimeMinutes Int              @default(0)
  wfhReason       String?
  gpsLatitude     Float?
  gpsLongitude    Float?
  source          String?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization  Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee      Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift         Shift?                 @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  geoFence      GeoFence?              @relation(fields: [geoFenceId], references: [id], onDelete: SetNull)
  breakLogs     BreakLog[]
  regularizations RegularizationRequest[]

  @@unique([orgId, employeeId, date])
  @@index([orgId, date])
  @@map("attendance_logs")
}

model BreakLog {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @db.Uuid
  attendanceLogId  String   @db.Uuid
  startAt          DateTime
  endAt            DateTime?
  durationMinutes  Int?
  reason           String?
  createdAt        DateTime @default(now())

  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  attendanceLog AttendanceLog @relation(fields: [attendanceLogId], references: [id], onDelete: Cascade)

  @@index([orgId, attendanceLogId])
  @@map("break_logs")
