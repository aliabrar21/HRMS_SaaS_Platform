# Root
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# Shared Security
JWT_ACCESS_SECRET=change_me_access_secret_key_32
JWT_REFRESH_SECRET=change_me_refresh_secret_key_32
JWT_INVITE_SECRET=change_me_invite_secret_key_32
JWT_PASSWORD_RESET_SECRET=change_me_password_reset_secret_key_32
JWT_TEMP_SECRET=change_me_temp_secret_key_32
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hrms?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/hrms?schema=public
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hrms_shadow?schema=public

# Redis / Queue
REDIS_URL=redis://127.0.0.1:6379
BULLMQ_PREFIX=hrms

# Mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="HRMS <no-reply@yourhrms.com>"

# Cloudflare R2
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_BUCKET=hrms
R2_PUBLIC_BASE_URL=

# OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common

# Observability
SENTRY_DSN=

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api
VITE_SENTRY_DSN=


